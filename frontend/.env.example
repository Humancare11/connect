# Video call behaviour switches. All default to ON; set a value to false to
# switch that behaviour off. Read at build time, so a rebuild is needed.
# No secrets belong in VITE_* variables: they end up in the public bundle.

# The doctor's browser restarts ICE itself when the patient's client cannot.
VITE_RTC_DOCTOR_ICE_RESTART=true

# Gentler recovery: try an ICE restart before rebuilding a resumed call, keep a
# call whose media still flows when only the peer's signaling is gone, and show
# no Retry button for a peer's signaling drop while the connection is healthy.
VITE_RTC_KEEP_LIVE_CALL=true
