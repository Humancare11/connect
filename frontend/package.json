{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:seo && vite build && npm run build:ssr && npm run copy:spa-fallback && node scripts/prerender.mjs --mode=production && npm run generate:sitemap -- --mode=production && npm run check:seo -- --dist",
    "build:prod": "npm run check:seo && vite build --mode production && npm run build:ssr -- --mode production && npm run copy:spa-fallback && node scripts/prerender.mjs --mode=production && npm run generate:sitemap -- --mode=production && npm run check:seo -- --dist",
    "build:uat": "npm run check:seo && vite build --mode uat && npm run build:ssr -- --mode uat && npm run copy:spa-fallback && node scripts/prerender.mjs --mode=uat && npm run generate:sitemap -- --mode=uat && npm run check:seo -- --dist",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "check:seo": "node scripts/check-seo.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "copy:spa-fallback": "node -e \"const fs=require('fs');fs.copyFileSync('dist/index.html','dist/200.html')\"",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@paypal/react-paypal-js": "^9.2.0",
    "@react-oauth/google": "^0.13.5",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@studio-freight/lenis": "^1.0.42",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "axios": "^1.15.2",
    "country-list": "^2.4.1",
    "country-state-city": "^3.2.1",
    "dompurify": "^3.4.16",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.4.2",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.21",
    "lodash": "^4.18.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-apple-signin-auth": "^1.1.2",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.6.0",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.13.2",
    "react-select": "^5.10.2",
    "socket.io-client": "^4.8.3",
    "swiper": "^12.1.3",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
