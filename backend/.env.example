# Placeholders only. Copy the lines you need into backend/.env (git-ignored). Never commit real values.

# ── Live Chat ────────────────────────────────────────────────────────────────
# Kill switch for the whole module (backend routes, sockets, AI). Default: false.
LIVECHAT_ENABLED=false
# 32 bytes as 64 hex characters (or base64). Required in production when LIVECHAT_ENABLED=true.
# Separate from CHAT_ENCRYPTION_KEY on purpose. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIVECHAT_ENCRYPTION_KEY=
# Optional, after a key change: the old key(s), comma separated, so older chats stay readable. New data always uses LIVECHAT_ENCRYPTION_KEY.
LIVECHAT_ENCRYPTION_KEY_PREVIOUS=
# Visitor presence: how long a visitor stays listed after their last tab closes (ms).
LIVECHAT_PRESENCE_GRACE_MS=30000
# Socket limits.
LIVECHAT_MAX_VISITOR_SOCKETS_PER_IP=20
LIVECHAT_MAX_ADMIN_SOCKETS_PER_IP=10

# AI (server-side only). Provider and model are configurable so they can be switched later.
LIVECHAT_AI_PROVIDER=openai
LIVECHAT_MODEL=gpt-6-luna
LIVECHAT_OPENAI_API_KEY=
# Optional, recommended in production: pin AI requests to the OpenAI organisation / project that holds the
# data-handling (HIPAA) agreement. A startup warning is logged in production when they are missing. Never logged.
LIVECHAT_OPENAI_ORG_ID=
LIVECHAT_OPENAI_PROJECT_ID=
# Lowest reasoning effort gpt-6-luna supports is "none" (it rejects "minimal"). Leave empty to send no reasoning
# parameter for models that do not accept one.
LIVECHAT_REASONING_EFFORT=none
LIVECHAT_MAX_OUTPUT_TOKENS=300
LIVECHAT_AI_TIMEOUT_MS=20000
# REQUIRED: USD per 1M tokens (gpt-6-luna, context under 272K). The daily spend cap needs them, and the AI will
# not run without them (patients then see the "AI unavailable" fallback; the log says "missing_prices").
# LIVECHAT_PRICE_INPUT_PER_1M and LIVECHAT_PRICE_OUTPUT_PER_1M are REQUIRED; the cached price falls back to the input price.
LIVECHAT_PRICE_INPUT_PER_1M=0.10
LIVECHAT_PRICE_CACHED_INPUT_PER_1M=0.01
LIVECHAT_PRICE_OUTPUT_PER_1M=0.50
# The daily AI spend cap ($3 by default) is edited in AI agent settings, not here.

# Abuse limits
LIVECHAT_MESSAGES_PER_MINUTE=6
# New chats per IP per rolling 24 h. Default 10 (offices, hospitals and mobile carriers share IPs).
# Outside production this limit is skipped for loopback and LIVECHAT_DEV_FAKE_IP. Old name LIVECHAT_IP_DAILY_CHAT_LIMIT still works.
LIVECHAT_CHATS_PER_IP_DAY=10
# One admin alert when an IP or a visitor starts this many chats within an hour.
LIVECHAT_ABUSE_CHATS_PER_HOUR=3

# File uploads (pdf, jpg, png; max 10 MB each, fixed). Stored in the S3 bucket from AWS_S3_BUCKET under livechat/.
LIVECHAT_MAX_FILES_PER_CHAT=10
LIVECHAT_UPLOADS_PER_10_MIN=5

# Offline follow-up email: sent through the Email module from this (active) company mailbox.
LIVECHAT_FOLLOWUP_MAILBOX=support@humancareconnect.co

# Visitor location (city/state/country) comes from the free DB-IP "IP to City Lite" file, never from a web service.
#   Download: https://db-ip.com/db/download/ip-to-city-lite  (gunzip it)
#   Save as:  backend/data/dbip-city-lite.mmdb  (git-ignored), or point GEOIP_DB_PATH at it.
#   Production: put the same file on the server (e.g. a Render disk / the deploy artifact) and set GEOIP_DB_PATH.
# GEOIP_DB_PATH=
# Behind a proxy (Render, Nginx): TRUST_PROXY=1 for one hop, 2 for two hops (e.g. Cloudflare/Render + Nginx); wrong
# values show the proxy's address instead of the visitor's.
# DEVELOPMENT ONLY: pretend every visitor has this PUBLIC IP so location can be tested on localhost. Ignored when
# NODE_ENV=production.
LIVECHAT_DEV_FAKE_IP=

# One-time deploy aid for the payment-owner check (Stripe metadata.userId / PayPal custom_id). Leave EMPTY normally. Set it to the
# deploy time (ISO, e.g. 2026-11-02T09:30:00Z) only for the first day: a Stripe intent / PayPal order with NO owner recorded is then
# accepted if it was created before that time AND is less than 24 hours old. Payments that have an owner must always match.
LEGACY_PAYMENT_OWNER_CUTOFF=

# ── Multi-currency and INR (India, paid through Razorpay) ─────────────────────
# Full guide: backend/docs/razorpay-inr.md
# Off by default. While off, every customer is priced and charged in USD (Stripe / PayPal), exactly as before.
MULTI_CURRENCY_ENABLED=
# INR (rupees, India only) is active ONLY when MULTI_CURRENCY_ENABLED=true AND BOTH keys below are set. Without them an Indian
# customer stays on USD / Stripe / PayPal; the server never sends anyone to Razorpay without keys.
# Razorpay dashboard > Account & Settings > API Keys (Test mode first: keys start with rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks: the secret you type when adding the webhook https://<your-domain>/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Frontend build-time flags (frontend/.env.*, not this file):
#   VITE_RAZORPAY_KEY_ID=rzp_test_...  OPTIONAL fallback only: the server returns the public key id with every order,
#                                      so Checkout works without it. The key SECRET never goes in a frontend file.
#   VITE_LIVECHAT_ENABLED=true        turns the widget and visitor tracker on in the browser build
