# Non-production search-taxonomy environment: TEMPLATE, placeholders only.
#
# Copy to backend/.env.search-dev (git-ignored) and fill in locally.
# Never commit real values. Never point any value below at authDB.
# See PR4.6_NON_PRODUCTION_DATABASE_PLAN.md.
#
# Load it explicitly (Node 22), e.g. from backend/:
#   node --env-file=.env.search-dev scripts/searchTaxonomy/checkMigrationTarget.js
# Variables set here take precedence over backend/.env for that process
# (dotenv does not override variables that are already set).

NODE_ENV=development

# Database the BACKEND and the dry-run PLANNER use in this process.
# For search testing against the non-production copy it must name the
# non-production database, e.g. .../authDB_search_dev
MONGO_URI=<application-runtime-mongodb-uri-for-the-non-production-database>

# Target of checkMigrationTarget.js and applySearchTaxonomyMigration.js.
# Must name the non-production database explicitly (e.g. .../authDB_search_dev).
# The scripts refuse authDB and the backend's own MONGO_URI database.
SEARCH_MIGRATION_MONGO_URI=<non-production-mongodb-uri-for-the-non-production-database>

SEARCH_CATALOG_TTL_MS=300000

# ── AI query understanding (POST /api/search, mode "full" only) ──
# Off unless exactly "true". With it off (or the model/key missing) search is
# fully deterministic. The OpenAI key itself is OPEN_AI_API_KEY, which lives
# only in the real (git-ignored) backend env file: never put it here, never
# in a VITE_* variable.
SEARCH_AI_ENABLED=false
# A small, low-latency model that supports Structured Outputs (json_schema).
# Empty = AI stays off.
OPENAI_SEARCH_MODEL=
# Per-request timeout in ms (500-10000). Empty = 3000.
OPENAI_SEARCH_TIMEOUT_MS=
# Server-wide AI calls per UTC day (0 disables AI). Empty = 500.
SEARCH_AI_DAILY_LIMIT=
 