# TEMPORARY step-0 speech test. Paste INSIDE the existing UAT `server { ... }` block (the one for uat.humancareconnect.co),
# next to the other `location` blocks. Replace SECRET with the output of:  openssl rand -hex 12
# Remove the whole block after the test (see README-UAT.md).

location = /step0-SECRET {
    return 301 /step0-SECRET/;
}

# ^~ makes this win over the app's regex locations.
location ^~ /step0-SECRET/ {
    auth_basic           "step0 test";
    auth_basic_user_file /etc/nginx/step0.htpasswd;

    proxy_pass           http://127.0.0.1:8787/;          # the trailing slash strips the /step0-SECRET/ prefix
    proxy_set_header     Host $host;
    proxy_set_header     X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header     X-Forwarded-Proto $scheme;
    proxy_read_timeout   60s;

    # A location with its own add_header drops the server-level ones, so repeat what matters:
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;
}
